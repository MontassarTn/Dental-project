# Copy to .env and fill in. Never commit .env.

# https://www.assemblyai.com/app/api-keys - live speech-to-text
ASSEMBLYAI_API_KEY=

# https://console.groq.com/keys - LLM that turns transcripts into chart updates
GROQ_API_KEY=
# Optional, defaults to openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# Same MongoDB database as the backend (database name: dentalChart)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dentalChart?retryWrites=true&w=majority
